// Let members of the "@ops_group@" group start/stop/restart @name@@* units
// without sudo, while leaving every other systemd unit on the host alone.
//
// Install as /etc/polkit-1/rules.d/49-@name@.rules (picked up automatically
// by polkit, no restart needed). Requires root to install; see install.sh.
//
// Note: this only covers org.freedesktop.systemd1.manage-units (start,
// stop, restart, kill, reset-failed). Polkit cannot scope
// manage-unit-files (enable/disable) to a single unit by name, so those go
// through the @name@-enable helper and its sudoers drop-in instead.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.isInGroup("@ops_group@")) {
        var unit = action.lookup("unit");
        if (unit && unit.indexOf("@name@@") == 0) {
            return polkit.Result.YES;
        }
    }
});
